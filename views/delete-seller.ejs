<h1 class="mb-4">Delete Seller</h1>
<div class="card card-body">
  <% if (seller.listing_count > 0) { %>
    <div class="alert alert-warning mb-3">
      <strong><%= seller.name %></strong> can't be deleted because they still have
      <%= seller.listing_count %> listing(s). Delete those listings or move them to another seller first.
    </div>
    <div>
      <a class="btn btn-outline-secondary" href="/sellers">Back to sellers</a>
    </div>
  <% } else { %>
    <p>Are you sure you want to delete this seller?</p>
    <ul class="mb-3">
      <li><strong>Name:</strong> <%= seller.name %></li>
      <li><strong>Email:</strong> <%= seller.email %></li>
    </ul>
    <p class="text-danger mb-3">This cannot be undone.</p>
    <form method="POST" class="d-flex gap-2">
      <button type="submit" class="btn btn-danger">Delete</button>
      <a class="btn btn-outline-secondary" href="/sellers">Cancel</a>
    </form>
  <% } %>
</div>