<h1 class="mb-4">Categories</h1>

<% if (categories.length===0) { %>
    <div class="alert alert-info" role="status">There are no categories yet.</div>
    <% } else { %>
        <ul class="list-group">
            <% for (let c of categories) { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <%= c.name %>
                        <span
                            class="badge <%= c.listing_count > 0 ? 'text-bg-primary' : 'text-bg-secondary' %> rounded-pill">
                            <%= c.listing_count %>
                        </span>
                </li>
                <% } %>
        </ul>
        <% } %>