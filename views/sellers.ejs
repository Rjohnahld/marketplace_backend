<h1 class="mb-4">Sellers</h1>

<% if (sellers.length === 0) { %>
  <div class="alert alert-info" role="status">There are no sellers yet.</div>
<% } else { %>
  <ul class="list-group">
    <% for (let s of sellers) { %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <div class="fw-semibold"><%= s.name %></div>
          <small class="text-body-secondary">
            <%= s.email %><% if (s.phone) { %> · <%= s.phone %><% } %>
          </small>
        </div>
        <span class="badge text-bg-primary"><%= s.listing_count %></span>
      </li>
    <% } %>
  </ul>
<% } %>