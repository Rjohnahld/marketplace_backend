<div class="mb-3">
  <label class="form-label" for="title">Title</label>
  <input class="form-control" type="text" id="title" name="title" maxlength="150" required
    value="<%= listing.title || '' %>">
</div>
<div class="mb-3">
  <label class="form-label" for="description">Description</label>
  <textarea class="form-control" id="description" name="description" rows="3"><%= listing.description || '' %></textarea>
</div>
<div class="row">
  <div class="col-sm mb-3">
    <label class="form-label" for="price">Price ($)</label>
    <input class="form-control" type="number" id="price" name="price" min="0" step="0.01" required
      value="<%= listing.price || '' %>">
  </div>
  <div class="col-sm mb-3">
    <label class="form-label" for="listed_on">Listed on</label>
    <input class="form-control" type="date" id="listed_on" name="listed_on" required
      value="<%= listing.listed_on || '' %>">
  </div>
</div>
<div class="row">
  <div class="col-sm mb-3">
    <label class="form-label" for="seller_id">Seller</label>
    <select class="form-select" id="seller_id" name="seller_id" required>
      <option value="">Choose a seller</option>
      <% for (let s of sellers) { %>
        <option value="<%= s.seller_id %>" <%= String(listing.seller_id) === String(s.seller_id) ? "selected" : "" %>>
          <%= s.name %>
        </option>
      <% } %>
    </select>
  </div>
  <div class="col-sm mb-3">
    <label class="form-label" for="category_id">Category</label>
    <select class="form-select" id="category_id" name="category_id" required>
      <option value="">Choose a category</option>
      <% for (let c of categories) { %>
        <option value="<%= c.category_id %>" <%= String(listing.category_id) === String(c.category_id) ? "selected" : "" %>>
          <%= c.name %>
        </option>
      <% } %>
    </select>
  </div>
</div>
<div class="form-check mb-3">
  <input class="form-check-input" type="checkbox" id="is_sold" name="is_sold" value="1"
    <%= listing.is_sold ? "checked" : "" %>>
  <label class="form-check-label" for="is_sold">Sold</label>
</div>