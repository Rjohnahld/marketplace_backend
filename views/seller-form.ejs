<div class="mb-3">
  <label class="form-label" for="name">Name</label>
  <input class="form-control" type="text" id="name" name="name" maxlength="100" required
    value="<%= seller.name || '' %>">
</div>
<div class="row">
  <div class="col-sm mb-3">
    <label class="form-label" for="email">Email</label>
    <input class="form-control" type="email" id="email" name="email" maxlength="150" required
      value="<%= seller.email || '' %>">
  </div>
  <div class="col-sm mb-3">
    <label class="form-label" for="phone">Phone <span class="text-body-secondary">(optional)</span></label>
    <input class="form-control" type="tel" id="phone" name="phone" maxlength="20"
      value="<%= seller.phone || '' %>">
  </div>
</div>