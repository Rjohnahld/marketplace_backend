<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Categories</h1>
    <a class="btn btn-primary" href="/category/create">Add Category</a>
</div>

<% if (categories.length===0) { %>
    <div class="alert alert-info" role="status">There are no categories yet.</div>
    <% } else { %>
        <ul class="list-group">
            <% for (let c of categories) { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <%= c.name %>
                        <div class="d-flex align-items-center gap-2">
                            <span
                                class="badge <%= c.listing_count > 0 ? 'text-bg-primary' : 'text-bg-secondary' %> rounded-pill">
                                <%= c.listing_count %>
                            </span>
                            <a class="btn btn-success btn-sm" href="/category/<%= c.category_id %>/edit">Edit</a>
                            <a class="btn btn-danger btn-sm" href="/category/<%= c.category_id %>/delete">Delete</a>
                        </div>
                </li>
                <% } %>
        </ul>
        <% } %>