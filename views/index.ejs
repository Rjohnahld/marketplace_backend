<h1 class="mb-4">Listings</h1>

<form method="GET" action="/" class="row g-2 mb-4">
    <div class="col-sm">
        <label class="form-label" for="search">Search by title</label>
        <input class="form-control" type="search" id="search" name="search" value="<%= search %>"
            placeholder="For example, chair">
    </div>
    <div class="col-sm">
        <label class="form-label" for="category_id">Category</label>
        <select class="form-select" id="category_id" name="category_id">
            <option value="">All categories</option>
            <% for (let c of categories) { %>
                <option value="<%= c.category_id %>" <%=String(c.category_id)===categoryId ? "selected" : "" %>>
                    <%= c.name %>
                </option>
                <% } %>
        </select>
    </div>
    <div class="col-sm">
        <label class="form-label" for="max_price">Max price ($)</label>
        <input class="form-control" type="number" id="max_price" name="max_price" min="0" step="0.01"
            value="<%= maxPrice %>">
    </div>
    <div class="col-sm-auto d-flex align-items-end gap-2">
        <button class="btn btn-primary" type="submit">Search</button>
        <a class="btn btn-outline-secondary" href="/">Clear</a>
    </div>
</form>

<% if (listings.length===0) { %>
    <div class="alert alert-info" role="status">
        <% if (search || categoryId || maxPrice) { %>
            No listings match your search.
            <% } else { %>
                There are no listings yet. Use Add Listing to create one.
                <% } %>
    </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Price</th>
                        <th>Category</th>
                        <th>Seller</th>
                        <th>Listed on</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let listing of listings) { %>
                        <tr>
                            <td>
                                <%= listing.title %>
                            </td>
                            <td>$<%= listing.price %>
                            </td>
                            <td>
                                <%= listing.category %>
                            </td>
                            <td>
                                <%= listing.seller %>
                            </td>
                            <td>
                                <%= listing.listed_on %>
                            </td>
                            <td>
                                <% if (listing.is_sold) { %>
                                    <span class="badge text-bg-secondary">Sold</span>
                                    <% } else { %>
                                        <span class="badge text-bg-success">Available</span>
                                        <% } %>
                            </td>
                            <td class="text-nowrap">
                                <a class="btn btn-success btn-sm"
                                    href="/listing/<%= listing.listing_id %>/edit">Edit</a>
                                <a class="btn btn-danger btn-sm"
                                    href="/listing/<%= listing.listing_id %>/delete">Delete</a>
                            </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>
        </div>
        <% } %>